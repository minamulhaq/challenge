          </mxGeometry>
        </mxCell>
        <mxCell id="e-ut-pure" value="calls directly" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontSize=9;fontStyle=1;" edge="1" source="ut-box" target="pure-box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-it-io" value="exercises via real bus" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;fontSize=9;fontStyle=1;" edge="1" source="it-box" target="io-box" parent="1">
          <mxGeometry relative="1" as="geometry" />
